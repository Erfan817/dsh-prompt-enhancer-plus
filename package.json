{
  "name": "dsh-prompt-enhancer-plus",
  "version": "1.7.0",
  "description": "Structured prompt enhancement for DSH plus thin adapters for VS Code, Cursor, Claude Code and any app via a local companion service and global hotkey.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Erfan817",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erfan817/prompt-spark.git"
  },
  "homepage": "https://github.com/Erfan817/prompt-spark#readme",
  "bugs": {
    "url": "https://github.com/Erfan817/prompt-spark/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-enhancer",
    "composer",
    "vscode-extension",
    "cursor",
    "claude-code",
    "hotkey"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./prompt-core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "personas.js",
    "preferences.js",
    "prompt-core.js",
    "skill-context.js",
    "test-*.mjs",
    "desktop/*.mjs",
    "desktop/*.cjs",
    "desktop/*.js",
    "desktop/*.html",
    "desktop/*.css",
    "desktop/package.json",
    "desktop/package-lock.json",
    "cli/*.mjs",
    "hotkey-tool/*.ps1",
    "hotkey-tool/*.cmd",
    "hotkey-tool/*.mjs",
    "hotkey-tool/*.md",
    "vscode-extension/**",
    "claude-code/**",
    ".claude/commands/enhance.md",
    "docs/*.md",
    "docs/*.svg",
    "启动通用窗口.cmd",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "node test-core.mjs && node test-host.mjs && node test-personas.mjs && node test-preferences.mjs && node test-client.mjs && node test-features.mjs && node test-skills.mjs && node desktop/test-desktop.mjs && node desktop/test-server.mjs && node vscode-extension/test-client.mjs && node hotkey-tool/test-cli.mjs",
    "ci:package": "node scripts/check-package.mjs",
    "claude:build": "node claude-code/build-native.mjs",
    "claude:validate": "node claude-code/build-native.mjs --check && claude plugin validate claude-code/native-plugin",
    "claude:test": "node claude-code/build-native.mjs --check && claude plugin test claude-code/native-plugin",
    "desktop": "node desktop/local.mjs",
    "desktop:smoke": "node desktop/local.mjs --smoke-test",
    "enhance": "node cli/enhance.mjs",
    "hotkey": "pwsh -NoProfile -ExecutionPolicy Bypass -Sta -File hotkey-tool/prompt-spark-hotkey.ps1",
    "desktop:electron": "npm --prefix desktop start",
    "desktop:setup": "npm --prefix desktop install",
    "desktop:electron:smoke": "npm --prefix desktop run smoke"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
