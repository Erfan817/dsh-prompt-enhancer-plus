{
  "name": "dsh-prompt-enhancer-plus",
  "version": "1.4.0",
  "description": "Natural plain-text prompt enhancement with editable full-text previews, reusable personas and a cross-application desktop companion.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Erfan817",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erfan817/prompt-spark.git"
  },
  "homepage": "https://github.com/Erfan817/prompt-spark#readme",
  "bugs": {
    "url": "https://github.com/Erfan817/prompt-spark/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-enhancer",
    "composer"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./prompt-core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "personas.js",
    "prompt-core.js",
    "test-*.mjs",
    "desktop/*.mjs",
    "desktop/*.cjs",
    "desktop/*.js",
    "desktop/*.html",
    "desktop/*.css",
    "desktop/package.json",
    "desktop/package-lock.json",
    "启动通用窗口.cmd",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "node test-core.mjs && node test-host.mjs && node test-personas.mjs && node test-client.mjs && node desktop/test-desktop.mjs && node desktop/test-server.mjs",
    "desktop": "node desktop/local.mjs",
    "desktop:smoke": "node desktop/local.mjs --smoke-test",
    "desktop:electron": "npm --prefix desktop start",
    "desktop:setup": "npm --prefix desktop install",
    "desktop:electron:smoke": "npm --prefix desktop run smoke"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
